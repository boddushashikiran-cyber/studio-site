# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — Project Settings -> API -> "service_role" secret.
# NEVER expose this with a NEXT_PUBLIC_ prefix. It bypasses Row Level
# Security entirely and is only ever read server-side (admin dashboard,
# the cron cleanup route).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard login (/admin) — pick your own values, not real examples.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=any-long-random-string

# Used to verify that /api/cron/cleanup-bookings is really being called
# by Vercel's cron scheduler and not by a random visitor. Set this to
# any long random string, and set the SAME value in Vercel's
# Environment Variables settings.
CRON_SECRET=any-other-long-random-string

# Resend (booking confirmation emails) — sign up free at resend.com,
# create an API key under API Keys. Without this set, bookings still
# save correctly, they just won't trigger a confirmation email.
RESEND_API_KEY=your-resend-api-key

# The "from" address on confirmation emails. Resend's shared testing
# address below works with zero setup, but can only deliver to the email
# you signed up to Resend with, and looks less polished in an inbox.
# Verify your own domain in Resend's dashboard, then set this to
# something like "bookings@yourdomain.com" for real bookings.
BOOKING_EMAIL_FROM=onboarding@resend.dev
